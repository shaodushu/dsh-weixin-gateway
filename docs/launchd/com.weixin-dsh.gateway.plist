<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  weixin-dsh-gateway 开机自启服务（macOS LaunchAgent）。
  ProgramArguments 启动守护脚本（while 循环自动重启网关，兜底 KeepAlive 不生效的系统行为）。

  管理命令：
    启动：   launchctl kickstart gui/$(id -u)/com.weixin-dsh.gateway
    停止：   launchctl bootout   gui/$(id -u)/com.weixin-dsh.gateway
    日志：   ~/.openclaw/weixin-dsh/launchd.out.log / gateway-daemon.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.weixin-dsh.gateway</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/baymax/Code/weixin-dsh-gateway/scripts/weixin-gateway-daemon.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/baymax/.openclaw/weixin-dsh/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/baymax/.openclaw/weixin-dsh/launchd.err.log</string>
</dict>
</plist>
